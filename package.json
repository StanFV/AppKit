{
  "name": "appkit-for-power-apps",
  "version": "1.3.0",
  "private": true,
  "description": "Browserextensie om Power Apps canvas schermen en controls als YAML te bewerken",
  "scripts": {
    "test": "node --test test/*.test.js",
    "icons": "node design/scripts/render-icons.js",
    "screenshots": "node design/scripts/screenshots.js",
    "package": "node -e \"const v=require('./extension/manifest.json').version;require('fs').mkdirSync('dist',{recursive:true});require('child_process').execSync('cd extension && zip -qr ../dist/appkit-'+v+'.zip . -x \\\".*\\\"',{stdio:'inherit'});console.log('dist/appkit-'+v+'.zip')\""
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
