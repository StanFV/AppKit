{
  "manifest_version": 3,
  "name": "AppKit for Power Apps",
  "short_name": "AppKit",
  "version": "1.4",
  "description": "Edit Power Apps canvas screens and controls as YAML: full editor, validation, outline and one-click replace in Studio.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AppKit",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.powerapps.com/*",
    "https://*.powerplatformusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.powerapps.com/*",
        "https://*.powerplatformusercontent.com/*"
      ],
      "js": [
        "src/content/studio.js"
      ],
      "css": [
        "src/content/studio.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.powerapps.com/*",
        "https://*.powerplatformusercontent.com/*"
      ],
      "js": [
        "src/content/page-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "open-editor": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open de geselecteerde control of het scherm in de YAML editor"
    }
  }
}
