{
  "manifest_version": 3,
  "name": "Power Apps Tools: YAML Editor",
  "short_name": "Power Apps Tools",
  "version": "1.0.0",
  "description": "Bewerk de YAML-code van Power Apps canvas schermen en controls in een volwaardige editor en plak ze terug in Power Apps Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Power Apps YAML Editor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://make.powerapps.com/*",
    "https://make.preview.powerapps.com/*",
    "https://*.create.powerapps.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://make.powerapps.com/*",
        "https://make.preview.powerapps.com/*",
        "https://*.create.powerapps.com/*"
      ],
      "js": [
        "src/content/studio.js"
      ],
      "css": [
        "src/content/studio.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.create.powerapps.com/*"
      ],
      "js": [
        "src/content/page-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "open-editor": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open de geselecteerde control of het scherm in de YAML editor"
    }
  }
}
